# Your LLMs API 
OPENROUTER_API_KEY="sk-or-v1-YOUR_API_KEY"
TAVILY_API_KEY="tvly-dev-YOUR_API_KEY"
CEREBRAS_API_KEY="csk-YOUR_API_KEY"

USE_LOCAL_LLM=False
LOCAL_LLM_HOST=None
LOCAL_LLM_PORT=None
LOCAL_LLM_MODEL=None

# Auth settings. Change Secret key
AUTH_JWT_SECRET="your-secret-key-min-32-chars"
AUTH_ALGORITHM=HS256
AUTH_ACCESS_EXPIRE_MINUTES=15
AUTH_REFRESH_EXPIRE_DAYS=7

# PostgreSQL settings
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=neurotest
POSTGRES_HOST=db
POSTGRES_PORT=5432
